{
  "name": "remote-pc-workspace",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/menu.js",
    "menu": "node scripts/menu.js",
    "build:exe": "python build_exe.py",
    "build:fast": "python build_exe.py --fast",
    "build:installer": "python build_exe.py --installer-only",
    "build:server": "python build_exe.py --server-only",
    "build:gui": "python build_exe.py --gui-only",
    "build:apk": "powershell -Command \"Set-Location client; .\\gradlew.bat assembleDebug --build-cache; Copy-Item 'app\\build\\outputs\\apk\\debug\\app-debug.apk' '..\\Remote PC.apk' -Force\"",
    "build:all": "npm run build:apk && npm run build:exe",
    "bump": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "release": "node scripts/bump-version.js --release",
    "release:fast": "node scripts/bump-version.js patch --release --fast",
    "release:quick": "node scripts/bump-version.js patch --release --skip",
    "release:cloud": "node scripts/bump-version.js patch --release --cloud",
    "release:exe": "node scripts/bump-version.js patch --release --exe-only",
    "release:apk": "node scripts/bump-version.js patch --release --apk-only",
    "release:clean": "node scripts/bump-version.js patch --release --clean",
    "release:patch": "node scripts/bump-version.js patch --release",
    "release:minor": "node scripts/bump-version.js minor --release",
    "release:major": "node scripts/bump-version.js major --release",
    "upload": "node scripts/upload-release.js"
  }
}
