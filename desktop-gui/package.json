{
  "name": "desktop-gui",
  "productName": "Remote PC GUI",
  "version": "3.4.0",
  "description": "Remote PC Control Suite & Wireless Server GUI",
  "author": "Priyan <priyan@remotepc.local>",
  "homepage": "https://github.com/priyan/Remote-Pc",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "electron:start": "cross-env NODE_ENV=development electron electron/main.cjs",
    "build:gui": "tsc -b && vite build && electron-builder --win --dir",
    "build:gui:linux": "tsc -b && vite build && electron-builder --linux --dir",
    "pack:dir": "tsc -b && vite build && electron-builder --win --dir",
    "pack:exe": "tsc -b && vite build && electron-builder --win portable",
    "pack:appimage": "tsc -b && vite build && electron-builder --linux AppImage",
    "pack:deb": "tsc -b && vite build && electron-builder --linux deb"
  },
  "build": {
    "appId": "com.remotepc.desktop",
    "productName": "Remote PC GUI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Remote_Server",
        "to": "Remote_Server"
      },
      {
        "from": "../server",
        "to": "server"
      }
    ],
    "win": {
      "icon": "../server/logo.ico",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "../server/logo.png",
      "category": "Utility",
      "target": [
        "dir",
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.16"
  }
}
